# Supabase の接続先。このファイルを .env にコピーして、値を書き換える（.env はリポジトリに入れない）
# 値は Supabase のダッシュボードの「Connect」（または Settings → API Keys）にある Project URL と Publishable key（sb_publishable_ で始まる公開用のキー。従来の anon key でも動く）
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# 利用規約とプライバシーポリシーのページの URL（ログイン画面と設定画面からリンクする）
VITE_TERMS_URL=
VITE_PRIVACY_URL=
